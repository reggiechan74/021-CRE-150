{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Landlord Investment Parameters Database Schema",
  "description": "Schema for landlord investment parameters database used for breakeven analysis in lease deal evaluation.",
  "type": "object",
  "required": ["version", "last_updated", "landlords"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "landlords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["landlord_legal_name", "investment_parameters"],
        "additionalProperties": false,
        "properties": {
          "landlord_legal_name": { "type": "string", "minLength": 1 },
          "landlord_aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "landlord_type": {
            "type": "string",
            "enum": ["REIT", "Private Equity", "Institutional", "Private Owner", "Fund", "Pension Fund", "Government", "Other"]
          },
          "primary_asset_class": {
            "type": "string",
            "enum": ["Industrial", "Office", "Retail", "Multi-Family", "Mixed-Use", "Other"]
          },
          "active": { "type": "boolean", "default": true },
          "notes": { "type": "string" },
          "investment_parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "default_acquisition_cost_psf": { "type": "number", "minimum": 0 },
              "going_in_ltv": { "type": "number", "minimum": 0, "maximum": 1 },
              "mortgage_amortization_months": { "type": "integer", "minimum": 12, "maximum": 600 },
              "dividend_yield": { "type": "number", "minimum": 0, "maximum": 1 },
              "interest_cost": { "type": "number", "minimum": 0, "maximum": 1 },
              "principal_payment_rate": { "type": "number", "minimum": 0, "maximum": 1 },
              "building_allocation_pct": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.40 },
              "default_remaining_depreciation_years": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 },
              "nominal_discount_rate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.10 },
              "notes": { "type": "string" }
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["property_address"],
              "additionalProperties": false,
              "properties": {
                "property_address": { "type": "string", "minLength": 1 },
                "property_name": { "type": "string" },
                "acquisition_cost": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
                "acquisition_cost_psf": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
                "acquisition_date": { "type": "string", "format": "date" },
                "gla_sf": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
                "year_built": { "type": "integer", "minimum": 1800, "maximum": 2100 },
                "property_specific_parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "going_in_ltv": { "type": "number", "minimum": 0, "maximum": 1 },
                    "interest_cost": { "type": "number", "minimum": 0, "maximum": 1 },
                    "building_allocation_pct": { "type": "number", "minimum": 0, "maximum": 1 },
                    "remaining_depreciation_years": { "type": "integer", "minimum": 1, "maximum": 50 }
                  }
                },
                "notes": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
